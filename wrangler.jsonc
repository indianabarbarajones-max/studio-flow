{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-flow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "STUDIO", "class_name": "Studio" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Studio"] }],
  "vars": { "AI_MODEL": "gpt-4.1-mini" },
  "secrets": { "required": ["APP_PIN"] },
  "observability": { "enabled": false }
}
